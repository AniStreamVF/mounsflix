# Variables d'environnement pour MounsFlix (Node standalone)
# Copie ce fichier en .env (ou définis ces vars sur ta plateforme d'hébergement)

# --- OBLIGATOIRE : clé TMDB (token read access ou API key) ---
TMDB_API_KEY=

# --- Optionnel : sous-titres OpenSubtitles ---
# Recherche = clé seule ; téléchargement = clé + user + pass
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=

# --- Optionnel : PostgreSQL pour le cache persistant (sinon cache mémoire) ---
# Ex : postgres://user:pass@host:5432/db   (Neon, Supabase… gratuits)
DATABASE_URL=

# Port HTTP (Render/Railway fournissent ceci automatiquement)
PORT=3000